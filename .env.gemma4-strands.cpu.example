# Pinned real model for CPU testing. No fake model or custom head training.
MODEL_BACKEND=gemma4_strands
MODEL_ID=google/gemma-4-E4B-it
MODEL_REVISION=ee0ef6023621cff504d758262d4e04895a5af4a2
STRANDS_CHECKPOINT=StrandsAgents/strands-decider-E4B-gemma4-v1-2610
STRANDS_REVISION=1344d44397c457f3be34b8ff15c593b41248c6bf
STRANDS_PROMPT_CONFIG=config/strands_requirements.yaml
DEVICE=cpu
DTYPE=float16
QUANTIZATION=smoothquant_int8
# Synthetic calibration gives a smoke-test artifact, NOT production validation.
QUANTIZED_MODEL_PATH=artifacts/gemma4-strands-sq-int8-smoke
MAX_CONTEXT_TOKENS=1024
DEFAULT_MAX_NEW_TOKENS=32
DECISION_CHECKPOINT=
POLICY_CONFIG=config/routing_policy.yaml
LOCAL_FILES_ONLY=true
LOG_LEVEL=INFO
UNSAFE_CONTENT_LOGGING=false
FEDERATION_ENABLED=false
