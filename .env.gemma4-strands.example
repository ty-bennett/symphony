# Experimental combined-prompt configuration. No initial custom head training.
MODEL_BACKEND=gemma4_strands
MODEL_ID=google/gemma-4-E4B-it
# Pinned revision recorded by the published Strands E4B checkpoint.
MODEL_REVISION=ee0ef6023621cff504d758262d4e04895a5af4a2
STRANDS_CHECKPOINT=StrandsAgents/strands-decider-E4B-gemma4-v1-2610
# Pin a reviewed Strands Hub commit in deployment, or use a provisioned directory.
STRANDS_REVISION=main
STRANDS_PROMPT_CONFIG=config/strands_requirements.yaml
DEVICE=cuda
# FP16 residual operations/embeddings/LM head/KV; decision heads remain FP32.
# Transformer attention/MLP linear weights and inputs use calibrated INT8.
DTYPE=float16
QUANTIZATION=smoothquant_int8
# Produce this immutable LOCAL artifact with scripts/quantize_smoothquant.py first.
# Paths are relative to the project directory (everything/).
QUANTIZED_MODEL_PATH=artifacts/gemma4-strands-sq-int8
MAX_CONTEXT_TOKENS=4096
DEFAULT_MAX_NEW_TOKENS=128
DECISION_CHECKPOINT=
POLICY_CONFIG=config/routing_policy.yaml
LOCAL_FILES_ONLY=false
LOG_LEVEL=INFO
UNSAFE_CONTENT_LOGGING=false
FEDERATION_ENABLED=false
