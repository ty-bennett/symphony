MODEL_ID=google/gemma-3-4b-it
# Pin a Hugging Face commit in deployment, identical on all federation clients.
MODEL_REVISION=main
MODEL_BACKEND=gemma3
DEVICE=cpu
DTYPE=float32
QUANTIZATION=none
# Optional pre-calibrated SmoothQuant artifact for the Gemma 4 + Strands backend.
# QUANTIZED_MODEL_PATH=artifacts/gemma4-strands-sq-int8
DECISION_CHECKPOINT=
POLICY_CONFIG=config/routing_policy.yaml
MAX_CONTEXT_TOKENS=2048
DEFAULT_MAX_NEW_TOKENS=128
PUBLIC_CONFIDENCE_FOR_FRONTIER=0.95
SENSITIVITY_THRESHOLD=0.80
LOG_LEVEL=INFO
UNSAFE_CONTENT_LOGGING=false
FEDERATION_ENABLED=false
# Alternative pretrained Gemma 4 + Strands profile: .env.gemma4-strands.example
# STRANDS_CHECKPOINT=StrandsAgents/strands-decider-E4B-gemma4-v1-2610
# STRANDS_REVISION=<reviewed-hub-commit>
# STRANDS_PROMPT_CONFIG=config/strands_requirements.yaml
