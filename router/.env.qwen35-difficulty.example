# Preferred runtime. Paths are relative to router/.
MODEL_BACKEND=qwen35_difficulty
MODEL_ID=Qwen/Qwen3.5-2B
MODEL_REVISION=15852e8c16360a2fea060d615a32b45270f8a8fc
DEVICE=cuda:0
DTYPE=float16
QUANTIZATION=modelopt_awq_int4
# Download quant/ from the link in difficulty-head/README.md to this location.
QUANTIZED_MODEL_PATH=models/qwen35-2b-router-awq/quant
DIFFICULTY_CHECKPOINT=difficulty-head/out/heads/difficulty.pt
DIFFICULTY_POLICY_CONFIG=config/difficulty_policy.yaml
AWQ_DEQUANT_CHUNK_ROWS=256
MAX_CONTEXT_TOKENS=2048
DEFAULT_MAX_NEW_TOKENS=128
LOCAL_FILES_ONLY=true
UNSAFE_CONTENT_LOGGING=false
FEDERATION_ENABLED=false
LOG_LEVEL=INFO
