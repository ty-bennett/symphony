# Where `opencode serve` is listening. The browser never talks to it directly;
# the app's /api/oc/* routes proxy every call.
OPENCODE_URL=http://127.0.0.1:4096

# Only needed if you started opencode with OPENCODE_SERVER_PASSWORD set.
# The username defaults to "opencode".
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# Everyone signs in (the first visit creates the owner account). Set this to 1
# to skip sign-in and treat every visitor as the owner. The coding agent can
# run shell commands, so only do this for a trusted local demo.
# OC_ALLOW_UNAUTHENTICATED=1

# Where settings and accounts (auth.json) are saved. Defaults to ./.symphony
# SYMPHONY_DATA_DIR=

