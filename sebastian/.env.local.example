# Where `opencode serve` is listening. The browser never talks to it directly;
# the app's /api/oc/* routes proxy every call.
OPENCODE_URL=http://127.0.0.1:4096

# Only needed if you started opencode with OPENCODE_SERVER_PASSWORD set.
# The username defaults to "opencode".
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# The coding agent can run shell commands, so /api/oc/* refuses requests in
# production until you wire checkAuth() in src/lib/opencode/server.ts to the
# app's login. Set this to 1 only for a trusted local demo.
# OC_ALLOW_UNAUTHENTICATED=1

# Where Privacy and spending settings are saved. Defaults to ./.symphony
# SYMPHONY_DATA_DIR=

