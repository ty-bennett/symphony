{
  "name": "Gmail for Symphony",
  "description": "Gives Symphony's agent the business's Gmail: search, read, send, reply, draft, mark as read, delete. Symphony asks the owner before anything that isn't reading.",
  "nodes": [
    {
      "parameters": {
        "authentication": "bearerAuth",
        "path": "symphony-gmail"
      },
      "id": "4ee5b6ff-d6e4-49c3-9164-ac8f6997641f",
      "name": "Symphony connects here",
      "type": "@n8n/n8n-nodes-langchain.mcpTrigger",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "086a52f0-e0c5-4bf5-8f99-73e9e0489cf0"
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Search the inbox with Gmail search syntax (for example: is:unread newer_than:7d, or from:jane@example.com). Returns each email's ID, sender, subject, date and a short preview.",
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": "={{ $fromAI('limit', 'How many emails to return, 1 to 25', 'number', 10) }}",
        "simple": true,
        "filters": {
          "q": "={{ $fromAI('query', 'Gmail search, for example is:unread newer_than:7d. Empty for the latest emails.', 'string', '') }}"
        },
        "options": {}
      },
      "id": "ca50a184-bddd-4243-9b60-d843c6f9654e",
      "name": "search_emails",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [
        -560,
        260
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Read one email in full, by its ID from search_emails.",
        "resource": "message",
        "operation": "get",
        "messageId": "={{ $fromAI('message_id', 'The email\\'s ID, from search_emails', 'string') }}",
        "simple": false,
        "options": {}
      },
      "id": "a21ca761-f2b1-4b52-8e87-7e08f5172738",
      "name": "read_email",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [
        -260,
        260
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Send a new email from the business's Gmail account.",
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $fromAI('to', 'Recipient email address(es), comma separated', 'string') }}",
        "subject": "={{ $fromAI('subject', 'Email subject', 'string') }}",
        "emailType": "text",
        "message": "={{ $fromAI('message', 'Email body, plain text', 'string') }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "684cff14-4e13-450c-aefd-9fd4de149310",
      "name": "send_email",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [
        40,
        260
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Reply to an email in its thread, by the email's ID.",
        "resource": "message",
        "operation": "reply",
        "messageId": "={{ $fromAI('message_id', 'ID of the email to reply to, from search_emails', 'string') }}",
        "emailType": "text",
        "message": "={{ $fromAI('message', 'Reply text, plain text', 'string') }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "24a05093-bc65-4b8f-a206-aae7f7403df7",
      "name": "reply_to_email",
