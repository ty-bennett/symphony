{
  "name": "Square for Symphony",
  "description": "Gives Symphony's agent the business's Square account: sales, customers, catalog and payment links. Uses a Square access token (Header Auth: Authorization = Bearer <token>).",
  "nodes": [
    {
      "parameters": {
        "authentication": "bearerAuth",
        "path": "symphony-square"
      },
      "id": "7732fbef-6271-4e73-bce6-6ba2fda2cfd5",
      "name": "Symphony connects here",
      "type": "@n8n/n8n-nodes-langchain.mcpTrigger",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "55e32413-da3c-4330-bc96-10d73d8f2ff9"
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Payments taken at the Square register since a time (amounts are in cents). Use for sales totals.",
        "method": "GET",
        "url": "https://connect.squareup.com/v2/payments",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "begin_time",
              "value": "={{ $fromAI('begin_time', 'Start time, RFC 3339, for example 2026-10-11T00:00:00-04:00', 'string') }}"
            },
            {
              "name": "sort_order",
              "value": "DESC"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        }
      },
      "id": "8f3d5b15-6f3c-4e48-9d53-b37395d4762c",
      "name": "get_sales",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        -560,
        260
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Find Square customers by email address or phone number.",
        "method": "POST",
        "url": "https://connect.squareup.com/v2/customers/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ limit: 10, query: { filter: String($fromAI('query', 'Email address or phone number to look for', 'string')).includes('@') ? { email_address: { fuzzy: $fromAI('query', 'Email address or phone number to look for', 'string') } } : { phone_number: { fuzzy: $fromAI('query', 'Email address or phone number to look for', 'string') } } } }) }}"
      },
      "id": "24f45f1b-7c07-43a8-93f3-54721c976b9c",
      "name": "search_customers",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        -260,
        260
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "List the items and prices in the Square catalog.",
        "method": "GET",
        "url": "https://connect.squareup.com/v2/catalog/list",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "types",
              "value": "ITEM"
            }
          ]
        }
      },
      "id": "6bb08bdc-2108-462e-b8b1-6ea71784ccb2",
      "name": "list_items",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        40,
        260
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "List the business's Square locations (needed for payment links).",
        "method": "GET",
        "url": "https://connect.squareup.com/v2/locations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "5300f2bc-8c87-4daf-b942-2974fa8f31a2",
      "name": "list_locations",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        340,
        260
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Add a customer to Square.",
        "method": "POST",
        "url": "https://connect.squareup.com/v2/customers",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ idempotency_key: String($now.toMillis()), given_name: $fromAI('first_name', 'First name', 'string', ''), family_name: $fromAI('last_name', 'Last name', 'string', ''), email_address: $fromAI('email', 'Email address', 'string', '') || undefined, phone_number: $fromAI('phone', 'Phone number', 'string', '') || undefined }) }}"
      },
      "id": "9bbbfb12-efeb-4317-bb96-3f7c6260afc3",
      "name": "create_customer",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        -560,
        480
      ]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Create a Square checkout link for a custom amount, to send to a customer.",
        "method": "POST",
        "url": "https://connect.squareup.com/v2/online-checkout/payment-links",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ idempotency_key: String($now.toMillis()), quick_pay: { name: $fromAI('name', 'What the payment is for', 'string'), price_money: { amount: Math.round($fromAI('amount', 'Amount in dollars', 'number') * 100), currency: 'USD' }, location_id: $fromAI('location_id', 'Location ID, from list_locations', 'string') } }) }}"
      },
      "id": "8650ecc7-cb41-4b67-8a24-70010aee4f32",
      "name": "create_payment_link",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        -260,
        480
      ]
    }
  ],
