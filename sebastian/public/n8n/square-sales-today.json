{
  "name": "Square: today's sales",
  "description": "Today's completed Square payments: how many, the total and tips. Send an empty body; no inputs needed.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "symphony-square-sales-today",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "d6a3ad3a-cbd7-467c-9b8c-02021aab1ee0",
      "name": "When Symphony asks",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "4ec988de-19ee-42df-ae47-9fc37c569527"
    },
    {
      "parameters": {
        "url": "https://connect.squareup.com/v2/payments",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "begin_time",
              "value": "={{ $now.startOf('day').toISO() }}"
            },
            {
              "name": "sort_order",
              "value": "DESC"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "id": "0573261e-8335-4fb6-9af9-5676074588cd",
      "name": "Get today's payments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Square access token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Adds up today's completed Square payments.\nconst payments = $input.first().json.payments ?? [];\nconst done = payments.filter((p) => p.status === 'COMPLETED');\nconst cents = done.reduce((sum, p) => sum + (p.amount_money?.amount ?? 0), 0);\nconst tips = done.reduce((sum, p) => sum + (p.tip_money?.amount ?? 0), 0);\nreturn [{\n  json: {\n    date: $now.toISODate(),\n    payments: done.length,\n    total: cents / 100,\n    tips: tips / 100,\n    currency: done[0]?.amount_money?.currency ?? 'USD',\n    more: Boolean($input.first().json.cursor),\n  },\n}];"
      },
      "id": "a342cac3-896e-4eff-9062-0cbc0bc1c4c1",
      "name": "Add up the sales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ]
    }
  ],
